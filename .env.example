# Copy to .env and fill in. .env is never committed.

# Required when Cantrip runs anywhere but your own computer: at least 12 characters.
CANTRIP_PASSWORD=

# Optional: only answer to this address (comma-separated), e.g. leads.example.com
CANTRIP_ALLOWED_HOSTS=

# Optional keys, so you don't type them into the app each run
GITHUB_TOKEN=
CANTRIP_AI_PROVIDER=
CANTRIP_AI_KEY=
CANTRIP_SEARCH=
CANTRIP_SEARCH_KEY=
